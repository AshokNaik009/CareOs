ELEVENLABS_API_KEY=your_elevenlabs_key
# AGENT_LLM=claude-haiku-4-5
AGENT_LLM_AR=
LLM_PROVIDERS=groq,openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER_ORDER=GMICloud
OPENROUTER_MODEL=minimax/minimax-m3
# PORT=3000

# Real phone calls from the Care OS ("Call phone" button). Needs a Twilio number imported into ElevenLabs.
# OUTBOUND_CALL_TO=+971501234567
# ELEVENLABS_PHONE_NUMBER_ID=   # optional: which imported number to call from (default: first Twilio number)
# OUTBOUND_WHATSAPP_TO=+971501234567   # WhatsApp number for the Care OS "WhatsApp" button (must join the Twilio sandbox)
# TWILIO_WHATSAPP_FROM=+14155238886     # optional: sender; defaults to the Twilio WhatsApp Sandbox
