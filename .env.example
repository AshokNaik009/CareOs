ELEVENLABS_API_KEY=your_elevenlabs_key
# AGENT_LLM=claude-haiku-4-5
AGENT_LLM_AR=
LLM_PROVIDERS=groq,openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER_ORDER=GMICloud
OPENROUTER_MODEL=minimax/minimax-m3
# PORT=3000

# Real phone calls from the Care OS ("Call phone" button). Needs a Twilio number imported into ElevenLabs.
# OUTBOUND_CALL_TO=+971501234567
# ELEVENLABS_PHONE_NUMBER_ID=   # optional: which imported number to call from (default: first Twilio number)
# OUTBOUND_WHATSAPP_TO=+971501234567   # WhatsApp number for the Care OS "WhatsApp" button (must join the Twilio sandbox)
# TWILIO_WHATSAPP_FROM=+14155238886     # optional: sender; defaults to the Twilio WhatsApp Sandbox
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Production (Render): APP_ORIGIN=https://rafeeq-fgsm.onrender.com with NODE_ENV=production.
# Register both redirect URLs in the WHOOP developer app (they must match exactly):
#   https://rafeeq-fgsm.onrender.com/live-health/auth/whoop/callback   (Live Health)
#   https://rafeeq-fgsm.onrender.com/whoop/callback                    (demo /whoop/connect)
APP_ORIGIN=http://localhost:3000
# LIVE_HEALTH_SAMPLE_DATA=false  # optional: restore real WHOOP REST data; default is labelled mock REST metrics, real Bluetooth only, calls blocked
# WHOOP_REDIRECT_URI=   # optional: overrides the demo callback, which defaults to <request host>/whoop/callback
TWILIO_CALLS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_ALLOWED_NUMBERS=
LIVE_HEALTH_ELEVENLABS_API_KEY=
LIVE_HEALTH_ELEVENLABS_AGENT_ID=
